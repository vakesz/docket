# ======================================================================
# Docket environment template
# ----------------------------------------------------------------------
# Copy to `.env` and fill in what's relevant. `docker compose up` reads
# this file. Anything blank falls back to defaults documented inline.
# ======================================================================

# ---- Shared (backend ↔ frontend) ----
# Bearer token the frontend server will attach to every /api/* call it
# proxies to the backend. The first-run setup wizard will write this
# exact value into config.toml as `http.token`, so after setup your
# frontend stays authenticated without any further wiring.
# GENERATE ONCE: `openssl rand -hex 32` and paste here.
DOCKET_API_TOKEN=

# Host port docker compose exposes the frontend on. Browser talks to
# http://localhost:${DOCKET_FRONTEND_PORT}.
DOCKET_FRONTEND_PORT=3000

# ---- Backend: first-run setup gate ----
# Auth token for the /setup/* surface when config.toml does not yet
# exist (bootstrap mode). Safe to reuse DOCKET_API_TOKEN — the backend
# accepts either during bootstrap. Once config.toml is written the
# setup token is no longer required.
DOCKET_SETUP_TOKEN=${DOCKET_API_TOKEN}

# ---- Backend: optional read-only switch ----
# Set to 1 to disable every mutation endpoint (demo-safe mode). Reads
# and chat stay available.
# DOCKET_READ_ONLY=0

# ---- Frontend → backend wiring (compose-internal) ----
# Compose sets this automatically; override only if you run the
# frontend outside compose and want to point it elsewhere.
# DOCKET_API_URL=http://backend:8765

# ---- Azure AI Foundry (chat / suggestions) ----
# Optional: can also be entered through the setup wizard once the
# bootstrap UI loads. If you prefill here, the backend skips the LLM
# step of the wizard and chat starts enabled from first boot.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Per-1M-token pricing for the chat ledger. Defaults match Azure
# OpenAI's GPT-5 Global list price ($1.25 in / $10 out as of 2026);
# override for mini / nano / Pro / enterprise-negotiated rates.
# DOCKET_PRICE_INPUT_PER_1M=1.25
# DOCKET_PRICE_OUTPUT_PER_1M=10.0

# ---- Local dev only: override XDG paths ----
# Ignored inside docker compose (the compose file mounts named volumes
# at the canonical XDG paths). Handy for `uv run docket` hacking.
# XDG_CONFIG_HOME=./.docket-dev/config
# XDG_STATE_HOME=./.docket-dev/state
# XDG_CACHE_HOME=./.docket-dev/cache
