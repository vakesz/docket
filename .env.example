# Production env for docker-compose. Copy to `.env` (gitignored) and fill in.
# `bin/generate-secrets.sh` can fill AUTH_SECRET and SECRETS_KEY for you.

# --- Required at boot ---

# Canonical URL the app is reached at. NextAuth uses this to build OAuth
# callback URLs. No trailing slash.
PUBLIC_BASE_URL=https://docket.example.com

# Random 32+ bytes for NextAuth session-cookie encryption. Rotating this
# logs everyone out.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# 32-byte base64 key used to AES-GCM-encrypt provider secrets at rest in the
# LlmProvider / OauthProviderConfig tables. Rotating this requires re-encrypting
# every existing row (no helper script today — set once at deploy).
# Generate with: openssl rand -base64 32
SECRETS_KEY=

# Postgres credentials for the bundled `db` service. The compose file points
# the app at `postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}`.
# To use an external Postgres instead, override DATABASE_URL in
# `compose.override.yml` and ignore POSTGRES_*.
POSTGRES_USER=docket
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docket

# --- Optional ---

# Host port the app binds to. Defaults to 3000.
# APP_PORT=3000

# Override DATABASE_URL if pointing at an external Postgres. If unset, the
# compose file builds it from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
# DATABASE_URL=postgresql://user:pass@host:5432/db?schema=public
