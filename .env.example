# Docket environment template.
#
# - Local dev:  copy to `.env.local` and fill in (gitignored, picked up by `bun run dev`).
# - Self-host:  copy to `.env`       and fill in (gitignored, read by docker-compose).
# - `bin/generate-secrets.sh` can mint AUTH_SECRET and SECRETS_KEY for you.

# ---------------------------------------------------------------------------
# Required at boot
# ---------------------------------------------------------------------------

# Canonical URL the app is reached at. NextAuth uses this to build OAuth
# callback URLs. No trailing slash.
#   dev:  http://localhost:3000
#   prod: https://docket.example.com
PUBLIC_BASE_URL="http://localhost:3000"

# 32+ bytes for NextAuth session-cookie encryption. Rotating this logs
# everyone out.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# 32-byte base64 key for AES-GCM encryption of provider secrets at rest
# (LlmProvider.apiKey, OauthProviderConfig.clientSecret).
# Optional in dev (rows fall back to plaintext); required in production.
# Rotating requires re-encrypting every existing row — set once at deploy.
# Generate with: openssl rand -base64 32
SECRETS_KEY=""

# Postgres connection. In dev, run the bundled DB with `docker compose up -d db`
# or point at any reachable Postgres (Neon dev branch, etc).
# In docker-compose self-host, leave DATABASE_URL unset and configure the
# bundled Postgres via POSTGRES_* below — the compose file wires it up.
DATABASE_URL="postgresql://docket:docket@localhost:5432/docket?schema=public"

# ---------------------------------------------------------------------------
# Self-hosted docker-compose only (the bundled `db` service)
# ---------------------------------------------------------------------------
# When DATABASE_URL is unset, the compose file builds it from these:
#   postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
# To use an external Postgres instead, override DATABASE_URL in
# `compose.override.yml` and ignore POSTGRES_*.
POSTGRES_USER=docket
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docket

# Host port the app binds to. Defaults to 3000.
# APP_PORT=3000

# ---------------------------------------------------------------------------
# Dev bootstrap seeds (consumed by `bin/seed-dev.ts` via the `predev` script)
# ---------------------------------------------------------------------------
# Each block is independent and idempotent. Seed runs on every `bun run dev`,
# writes only when the corresponding row is missing, and short-circuits
# entirely once the global `setup.complete` Setting flips to true (one LLM
# and one OAuth provider both observed). After that, the DB is the source
# of truth — admin UI changes are never stomped.
#
# The same script runs in production via the docker entrypoint, so leaving
# these populated in dev mirrors the production bootstrap exactly.

# OpenAI API key for the agent. First LLM row also becomes the global default.
DEV_OPENAI_API_KEY=""

# GitHub OAuth App for sign-in. Register at https://github.com/settings/developers
# Authorization callback URL: ${PUBLIC_BASE_URL}/api/auth/callback/github
DEV_GITHUB_CLIENT_ID=""
DEV_GITHUB_CLIENT_SECRET=""
