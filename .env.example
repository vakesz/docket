# Docket environment template.
#
# Self-host quickstart needs almost nothing here — the entrypoint auto-
# generates AUTH_SECRET / SECRETS_KEY into a docker volume on first boot,
# and the in-browser setup wizard collects OAuth + LLM credentials. You
# only need to set values below if you want to:
#
#   1. Pre-fill the wizard from env (`DEV_*` block — skips the wizard once
#      both an OAuth and (optionally) LLM row exist), or
#   2. Pin AUTH_SECRET / SECRETS_KEY explicitly (e.g. shared across instances).
#
# - Local dev:  copy to `.env.local` and fill in (gitignored, picked up by `bun run dev`).
# - Self-host:  copy to `.env`       and fill in (gitignored, read by docker-compose).

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Canonical URL the app is reached at. No trailing slash. Auth.js uses this
# to build OAuth callback URLs.
PUBLIC_BASE_URL="http://localhost:3000"

# Postgres connection. Local dev: run the bundled DB with `docker compose
# up -d db` or point at any reachable Postgres. Docker-compose self-host:
# leave unset; compose builds the URL from the POSTGRES_* values below.
DATABASE_URL="postgresql://docket:docket@localhost:5432/docket?schema=public"

# ---------------------------------------------------------------------------
# Optional — pin secrets instead of letting the entrypoint generate them
# ---------------------------------------------------------------------------
# Generate with `bin/generate-secrets.sh` or `openssl rand -base64 32`.
# In docker-compose self-host you can leave both blank — the entrypoint
# writes them to the `docket-secrets` named volume on first boot.

# AUTH_SECRET=""        # NextAuth session-cookie encryption.
# SECRETS_KEY=""        # AES-GCM key for provider secrets at rest.

# Auth.js v5 refuses non-Vercel hosts in production unless this is set.
# Already baked into the Docker image; uncomment if you run `bun run start`
# directly on a non-Vercel host.
# AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# Docker-compose self-host (bundled Postgres)
# ---------------------------------------------------------------------------
POSTGRES_USER=docket
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docket
# APP_PORT=3000

# ---------------------------------------------------------------------------
# Optional — pre-fill the setup wizard from env
# ---------------------------------------------------------------------------
# When set, `bin/seed-dev.ts` writes the matching rows on boot (idempotent),
# the global `setup.complete` flag flips, and the in-browser wizard is
# skipped. Leave blank to use the wizard at http://localhost:3000.

# OpenAI API key for the agent. First LLM row also becomes the global default.
DEV_OPENAI_API_KEY=""
# Optional overrides applied only when the LlmProvider row is first created.
# Once the row exists, edit these in the admin UI — re-seeds won't stomp them.
# DEV_OPENAI_MODEL=""                          # default: gpt-5
# DEV_OPENAI_BASE_URL=""                       # empty = vendor default; set for Azure / proxy / Ollama OpenAI-compatible
# DEV_OPENAI_INPUT_PRICE_CENTS_PER_MTOK=""     # USD cents per 1M prompt tokens
# DEV_OPENAI_OUTPUT_PRICE_CENTS_PER_MTOK=""    # USD cents per 1M completion tokens

# GitHub OAuth App. Register at https://github.com/settings/developers
# Callback URL: ${PUBLIC_BASE_URL}/api/auth/callback/github
DEV_GITHUB_CLIENT_ID=""
DEV_GITHUB_CLIENT_SECRET=""
