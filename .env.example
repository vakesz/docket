# ======================================================================
# Docket environment template — copy to `.env` and fill in.
# Loaded by the backend (`docket serve` / CLI / TUI) and by the frontend
# dev + prod servers. After `docket setup`, most values live in
# config.toml; only entries whose comment says otherwise stay here.
# ======================================================================

# ---- Local dev: redirect XDG paths into this repo ----
# The "docket" subdir is appended automatically. `frontend/resolve-backend-config.ts`
# honors these too, so both stacks agree on where config.toml lives.
# XDG_CONFIG_HOME=./.docket-dev/config
# XDG_STATE_HOME=./.docket-dev/state
# XDG_CACHE_HOME=./.docket-dev/cache

# ---- HTTP bearer (bootstrap / override) ----
# After setup, config.toml's `[http] token` is what the frontend reads
# and the backend validates against. Set this only when:
#   1. Bootstrapping — `make env` mints a token here; `docket setup`
#      mirrors it into config.toml, then you can clear this line.
#   2. CI / containers that can't read config.toml — this env var wins
#      over the config.toml value.
DOCKET_API_TOKEN=

# Bearer accepted by the backend's /setup/* surface in bootstrap mode
# (before config.toml exists). Mirrors DOCKET_API_TOKEN so bootstrap
# works from a single token.
DOCKET_SETUP_TOKEN=${DOCKET_API_TOKEN}

# ---- Frontend ↔ backend wiring ----
# Override only if the backend is not on the default 127.0.0.1:8765.
# DOCKET_API_URL=http://127.0.0.1:8765

# ---- Backend switches ----
# Set to 1 to disable every mutation endpoint (demo-safe mode).
# DOCKET_READ_ONLY=0
# Uvicorn log level: critical | error | warning | info | debug | trace.
# DOCKET_LOG_LEVEL=info

# ---- Azure OpenAI (chat / suggestions) ----
# Endpoint + deployment can live in `config.toml` after `docket setup`
# runs the `llm` step; values set here override those at runtime. The
# API key has no config.toml home and always stays in .env.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Per-1M-token pricing for the chat ledger. Defaults match Azure
# OpenAI's GPT-5 Global list price ($1.25 in / $10 out as of 2026);
# override for mini / nano / Pro / enterprise-negotiated rates.
# DOCKET_PRICE_INPUT_PER_1M=1.25
# DOCKET_PRICE_OUTPUT_PER_1M=10.0
