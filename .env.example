# Azure AI Foundry (OpenAI-compatible endpoint)
# The wizard can write these for you; this file documents the shape.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Optional: override XDG paths (Linux-style on macOS if you prefer)
# XDG_CONFIG_HOME=
# XDG_STATE_HOME=
# XDG_CACHE_HOME=

# --- Dev override: keep all config, db, and logs inside this repo ---
# Uncomment the three lines below to run `docket` with everything under ./.docket-dev/
# instead of your real user dirs. Handy for hacking without polluting ~/.config
# or ~/.local/state. The "docket" subdir is appended automatically,
# so the effective paths become:
#   ./.docket-dev/config/docket/   (config.toml, .env)
#   ./.docket-dev/state/docket/    (docket.db, logs)
#   ./.docket-dev/cache/docket/    (telemetry, tmp)
# Remember to add .docket-dev/ to your .gitignore.
# XDG_CONFIG_HOME=./.docket-dev/config
# XDG_STATE_HOME=./.docket-dev/state
# XDG_CACHE_HOME=./.docket-dev/cache
