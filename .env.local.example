# Phase 0 — minimum env to boot the dev server.
# Copy to .env.local and fill in. .env.local is gitignored.

# --- Required at boot ---
# Postgres connection. Local: `docker compose up -d db` once the compose file lands in Phase 11,
# or point at a Neon dev branch. Schema is empty in Phase 0; Phase 2 adds tables.
DATABASE_URL="postgresql://docket:docket@localhost:5432/docket?schema=public"

# Symmetric secret used to encrypt session cookies. 32+ random bytes.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Canonical URL the app is reached at — required by NextAuth for OAuth callbacks
# even in dev (use http://localhost:3000 locally).
PUBLIC_BASE_URL="http://localhost:3000"

# --- Development OAuth (lets `bun run dev` sign in via GitHub) ---
# Register a GitHub OAuth App at https://github.com/settings/developers
# Authorization callback URL: ${PUBLIC_BASE_URL}/api/auth/callback/github
#
# Runtime auth (Phase 2+) reads OAuth config from the OauthProviderConfig
# table, NOT from these env vars. The `predev` script (`bin/seed-dev.ts`)
# upserts a row from these values before each `bun run dev`. Phase 11
# replaces the seed with a first-run admin wizard.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Future (Phase 11 wires the rest into a first-run admin wizard) ---
# Symmetric key used to encrypt provider secrets at rest. 32 bytes, base64.
# Required from Phase 11; harmless to set early.
SECRETS_KEY=""
