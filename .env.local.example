# Local dev env for `bun run dev`. Copy to .env.local and fill in.
# .env.local is gitignored.
#
# For production self-host, see .env.example and the README "Self-hosting"
# section — different file, different gating, same encryption.

# --- Required at boot ---

# Postgres connection. Run a local DB with `docker compose up -d db` (uses the
# bundled Postgres from docker-compose.yml — credentials default to docket/docket
# unless you've changed POSTGRES_* in .env), or point at any reachable Postgres
# (Neon dev branch, etc).
DATABASE_URL="postgresql://docket:docket@localhost:5432/docket?schema=public"

# Symmetric secret used to encrypt session cookies. 32+ random bytes.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Symmetric key the app uses to AES-GCM-encrypt provider secrets at rest in
# the LlmProvider / OauthProviderConfig tables. 32 bytes, base64.
# Generate with: openssl rand -base64 32
# Optional in dev (rows fall back to plaintext); required in production.
SECRETS_KEY=""

# Canonical URL the app is reached at — required by NextAuth for OAuth callbacks
# even in dev (use http://localhost:3000 locally).
PUBLIC_BASE_URL="http://localhost:3000"

# --- Bootstrap seeds (consumed by `bin/seed-dev.ts` via the `predev` script) ---
# Each block is independent and idempotent. Seed runs on every `bun run dev`,
# writes only when the corresponding row is missing, and short-circuits
# entirely once the global `setup.complete` Setting flips to true (one LLM
# and one OAuth provider both observed). After that, the DB is the source
# of truth — admin UI changes are never stomped.
#
# The same script runs in production via the docker entrypoint, so leaving
# these populated in dev mirrors the production bootstrap exactly.

# OpenAI API key for the agent. First LLM row also becomes the global default.
DEV_OPENAI_API_KEY=""

# GitHub OAuth App for sign-in. Register at https://github.com/settings/developers
# Authorization callback URL: ${PUBLIC_BASE_URL}/api/auth/callback/github
DEV_GITHUB_CLIENT_ID=""
DEV_GITHUB_CLIENT_SECRET=""
