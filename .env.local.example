# Local dev env. Copy to .env.local and fill in. .env.local is gitignored.

# --- Required at boot ---
# Postgres connection. Local: `docker compose up -d db` once the compose file
# lands in Phase 11f, or point at any reachable Postgres (Neon dev branch, etc).
DATABASE_URL="postgresql://docket:docket@localhost:5432/docket?schema=public"

# Symmetric secret used to encrypt session cookies. 32+ random bytes.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Symmetric key the app uses to AES-GCM-encrypt provider secrets at rest in
# the LlmProvider / OauthProviderConfig tables. 32 bytes, base64.
# Generate with: openssl rand -base64 32
# Optional in dev (rows fall back to plaintext); required in production.
SECRETS_KEY=""

# Canonical URL the app is reached at — required by NextAuth for OAuth callbacks
# even in dev (use http://localhost:3000 locally).
PUBLIC_BASE_URL="http://localhost:3000"

# --- Dev-only seeds (consumed by `bin/seed-dev.ts` via the `predev` script) ---
# Each block is independent and idempotent. Seed runs once on `bun run dev`,
# writes only when the corresponding row is missing, and short-circuits
# entirely once `setup.complete` is true (post-bootstrap, the DB is the
# source of truth — admin UI changes are never stomped).
#
# Production builds skip the seed regardless of these vars (NODE_ENV gate).

# OpenAI API key for the agent. First LLM row also becomes the global default.
DEV_OPENAI_API_KEY=""

# GitHub OAuth App for sign-in. Register at https://github.com/settings/developers
# Authorization callback URL: ${PUBLIC_BASE_URL}/api/auth/callback/github
DEV_GITHUB_CLIENT_ID=""
DEV_GITHUB_CLIENT_SECRET=""
