{
  "name": "docket",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.13",
  "scripts": {
    "predev": "bun --conditions=react-server bin/seed-dev.ts",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "seed:dev": "bun --conditions=react-server bin/seed-dev.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^22.0.1",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@tanstack/react-query": "5.100.5",
    "@trpc/client": "11.16.0",
    "@trpc/next": "11.16.0",
    "@trpc/react-query": "11.16.0",
    "@trpc/server": "11.16.0",
    "azure-devops-node-api": "^15.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "next-auth": "5.0.0-beta.31",
    "openai": "6.34.0",
    "pg": "8.20.0",
    "pino": "10.3.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "server-only": "0.0.1",
    "shadcn": "^4.5.0",
    "superjson": "2.2.6",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@tailwindcss/postcss": "4.2.4",
    "@types/node": "25.6.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "dotenv": "17.4.2",
    "jsdom": "29.0.2",
    "pino-pretty": "13.1.3",
    "prisma": "7.8.0",
    "tailwindcss": "4.2.4",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "overrides": {
    "postcss": "8.5.12",
    "@hono/node-server": "1.19.13",
    "std-env": "4.1.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
