{
  "name": "docket",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "predev": "prisma db push --accept-data-loss && tsx --conditions=react-server bin/apply-raw-sql.ts && tsx --conditions=react-server bin/seed-dev.ts",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "seed:dev": "tsx --conditions=react-server bin/seed-dev.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.2",
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^5.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^22.0.1",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@tanstack/react-query": "5.100.6",
    "@trpc/client": "11.17.0",
    "@trpc/next": "11.17.0",
    "@trpc/react-query": "11.17.0",
    "@trpc/server": "11.17.0",
    "azure-devops-node-api": "^15.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "17.4.2",
    "hast-util-to-text": "^4.0.2",
    "highlight.js": "^11.11.1",
    "jsdom": "^29.1.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "openai": "6.35.0",
    "pg": "8.20.0",
    "pino": "10.3.1",
    "prisma": "7.8.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "^7.74.0",
    "react-markdown": "10",
    "react-resizable-panels": "^4.10.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "superjson": "2.2.6",
    "tailwind-merge": "^3.5.0",
    "turndown": "^7.2.4",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@tailwindcss/postcss": "4.2.4",
    "@types/hast": "^3.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "25.6.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "6.0.1",
    "esbuild": "^0.28.0",
    "pino-pretty": "13.1.3",
    "tailwindcss": "4.2.4",
    "tsx": "^4.19.2",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.12",
      "@hono/node-server": "1.19.13",
      "std-env": "4.1.0"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver",
      "esbuild",
      "@biomejs/biome",
      "@tailwindcss/oxide",
      "@prisma/engines",
      "prisma",
      "msw"
    ]
  }
}
