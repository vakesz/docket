{
  "name": "docket",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10.0.0",
    "pnpm": ">=9.15.4"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "predev": "tsx --conditions=react-server bin/db-migrate.ts && tsx --conditions=react-server bin/bootstrap-providers.ts",
    "dev": "next dev --turbopack",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose stop db",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server bin/db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@auth/drizzle-adapter": "^1.11.3",
    "@hookform/resolvers": "^5.9.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@octokit/rest": "^22.0.1",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-virtual": "^3.14.13",
    "@trpc/client": "11.19.0",
    "@trpc/next": "11.19.0",
    "@trpc/react-query": "11.19.0",
    "@trpc/server": "11.19.0",
    "azure-devops-node-api": "^15.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "^0.45.3",
    "hast-util-to-text": "^4.0.2",
    "highlight.js": "^11.12.0",
    "jsdom": "^29.1.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "openai": "6.49.0",
    "pino": "10.3.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "react-markdown": "10",
    "react-resizable-panels": "^4.13.3",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "superjson": "2.2.6",
    "tailwind-merge": "^3.7.0",
    "turndown": "^7.2.4",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "4.3.3",
    "@types/hast": "^3.0.5",
    "@types/jsdom": "^28.0.1",
    "@types/node": "25.9.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "pino-pretty": "13.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.12",
      "@hono/node-server": "1.19.13",
      "std-env": "4.1.0"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver",
      "esbuild",
      "@biomejs/biome",
      "@tailwindcss/oxide",
      "msw"
    ]
  }
}
