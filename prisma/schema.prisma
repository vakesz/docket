// Docket schema. Every persisted concept lives here: NextAuth tables,
// multi-tenancy (Project / ProviderConfig), the item cache + comments,
// conversations + messages, proposals, memory + sources, watchlist, MCP
// server config, settings, suggestions, command-usage counters, sync cursors.
//
// Naming conventions:
// - camelCase fields throughout (Prisma default).
// - Provider-kind / LLM-kind / role / proposal-kind use plain `String` so
//   adding a new value is a row, not a migration. The string-literal-union
//   types in `src/core/types.ts` and `src/core/proposal-types.ts` are the
//   source of truth at the application layer.
// - Provider-scope / payload / config use `Json` so per-provider shapes
//   evolve without a migration.

generator client {
  provider = "prisma-client"
  output   = "../src/db/generated"
}

// Connection URL lives in prisma.config.ts for migrations and is passed to
// PrismaClient via a runtime adapter (@prisma/adapter-pg) at boot.
datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// NextAuth v5 / @auth/prisma-adapter
// ----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// Per-user landing project. `/` redirects here when set; falls back to the
  /// first membership if null or stale. Cleared automatically when the
  /// referenced project is deleted (SetNull) so the redirect can re-fall-back
  /// without an extra check.
  defaultProjectId String?
  defaultProject   Project? @relation("UserDefaultProject", fields: [defaultProjectId], references: [id], onDelete: SetNull)

  accounts      Account[]
  sessions      Session[]
  ownedProjects Project[]           @relation("ProjectOwner")
  memberships   ProjectMembership[]
  conversations Conversation[]
  proposals     Proposal[]
  watchlist     WatchlistEntry[]
  commandUsage  CommandUsage[]
  settings      Setting[]
  savedViews    SavedView[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----------------------------------------------------------------------------
// Per-deployment OAuth + LLM config. Bootstrap happens via env-driven seed
// (`bin/seed-dev.ts`); afterwards the operator manages rows from `/admin`.
// Multi-row from day one; `kind` accepts future vendors without a migration.
// ----------------------------------------------------------------------------

model OauthProviderConfig {
  id           String   @id @default(cuid())
  /// 'github' | 'azure_devops' | future kinds. NextAuth's dynamic provider
  /// config function dispatches on this string.
  kind         String
  /// Human-readable label shown in the sign-in button + admin list.
  label        String
  clientId     String
  /// AES-256-GCM ciphertext (`enc:v1:<iv>:<ct+tag>`) when SECRETS_KEY is set;
  /// legacy plaintext rows are still readable and re-encrypt on next write.
  /// See `src/server/secrets/encryption.ts`.
  clientSecret String
  /// Comma-separated scope list. Provider-specific syntax.
  scopes       String   @default("")
  /// Optional override for the OAuth API base URL (self-hosted GitHub
  /// Enterprise, AzDO on a custom domain, etc.). Empty string = stock.
  baseUrl      String   @default("")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([kind])
}

model LlmProvider {
  id        String   @id @default(cuid())
  /// 'openai' | future vendors ('anthropic', 'gemini', 'bedrock', 'mistral',
  /// 'ollama', ...). The agent's `selectAdapterFor` dispatches on this;
  /// the OpenAI adapter ships today, future adapters are one file each.
  kind      String
  label     String
  /// AES-256-GCM ciphertext (`enc:v1:<iv>:<ct+tag>`) when SECRETS_KEY is set;
  /// legacy plaintext rows are still readable and re-encrypt on next write.
  apiKey    String
  /// Default model for this provider row (e.g. 'gpt-5'). Empty falls back
  /// to the adapter's hardcoded default.
  model     String   @default("")
  /// Optional base URL (Azure AI Foundry v1 endpoint, OpenAI-compatible
  /// Ollama endpoint, proxies). Empty = vendor default.
  baseUrl   String   @default("")
  /// Per-million-tokens prompt-side price in USD cents. Null = unknown,
  /// in which case `estimateCostCents` returns undefined for any turn the
  /// API doesn't surface a precomputed cost for, and budget tracking
  /// silently undercounts. Set both fields when adding a new model.
  inputPriceCentsPerMtok  Float?
  outputPriceCentsPerMtok Float?
  /// Whether this row is the global fallback when a project has no
  /// defaultLlmProviderId. At most one row should have this true, but the
  /// constraint is application-level (no DB unique partial index for now).
  isDefault Boolean  @default(false)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  defaultedByProjects   Project[]      @relation("ProjectDefaultLlm")
  conversationOverrides Conversation[] @relation("ConversationLlmOverride")

  @@index([kind])
  @@index([isDefault])
}

// ----------------------------------------------------------------------------
// Multi-tenancy: projects + memberships
// ----------------------------------------------------------------------------

model Project {
  id                   String    @id @default(cuid())
  /// Display name for the project ("ACME / web", "Contoso Platform").
  name                 String
  description          String    @default("")
  /// Provider kind this project targets — 'github' | 'azure_devops' | ...
  /// Same vocabulary as OauthProviderConfig.kind.
  providerKind         String
  /// Per-provider scope payload (e.g. `{ owner: "acme", repo: "web" }` for
  /// GitHub, `{ organization: "Contoso", project: "Platform" }` for AzDO).
  /// Schemas live in each provider module's spec; this column doesn't
  /// validate.
  providerScope        Json
  /// Project-level LLM choice; falls back to the global default LlmProvider
  /// if null. Per-conversation override on Conversation.llmProviderIdOverride.
  defaultLlmProviderId String?
  /// Project-level sampling temperature for the agent loop. Null → adapter
  /// default. Conversation/per-turn overrides still win.
  defaultTemperature   Float?
  /// Owner has implicit membership; explicit memberships go through
  /// ProjectMembership. Owner can delete the project; members cannot.
  ownerUserId          String
  createdAt            DateTime  @default(now())
  archivedAt           DateTime?
  updatedAt            DateTime  @updatedAt

  owner         User                @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  defaultLlm    LlmProvider?        @relation("ProjectDefaultLlm", fields: [defaultLlmProviderId], references: [id], onDelete: SetNull)
  defaultForUsers User[]            @relation("UserDefaultProject")
  memberships   ProjectMembership[]
  items         Item[]
  watchlist     WatchlistEntry[]
  memory        MemoryEntry[]
  sources       SourceDoc[]
  conversations Conversation[]
  proposals     Proposal[]
  mcpServers    McpServerConfig[]
  settings      Setting[]
  suggestions   Suggestion[]
  commandUsage  CommandUsage[]
  sync          SyncCursor?
  savedViews    SavedView[]
  audits        Audit[]
  webFetches    WebFetchEvent[]

  @@index([ownerUserId, archivedAt])
  @@index([providerKind])
}

/// Per-user role on a project. Roles are 'viewer' | 'member' | 'approver';
/// the permission matrix is enforced in `src/server/auth-roles.ts` and
/// referenced by every protected procedure.
model ProjectMembership {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  /// 'viewer' | 'member' | 'approver'.
  role      String   @default("member")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// Item cache + comments — populated by sync, refreshed on confirm
// ----------------------------------------------------------------------------

model Item {
  id             String   @id @default(cuid())
  projectId      String
  /// Provider-native id (e.g. "acme/web#42" for GitHub, "1234" for AzDO).
  /// Stable across syncs; the surrogate `id` is the FK target for everything
  /// else so renames at the provider don't ripple.
  providerItemId String
  /// Canonical kind: ItemKind in src/core/types.ts.
  kind           String
  title          String
  descriptionMd  String   @default("")
  /// Canonical state: ItemState in src/core/types.ts. Provider-native state
  /// strings are translated by each provider's state-map.ts.
  state          String
  assignee       String?
  author         String?
  /// Parent's providerItemId, not the surrogate cuid. Resolved at query
  /// time; null when no parent or parent is outside the synced cache.
  parentId       String?
  tags           String[] @default([])
  providerRaw    Json     @default("{}")
  url            String?
  repositoryUrl  String?
  /// Provider-side creation timestamp ("Opened" date in the UI). Nullable
  /// because legacy/cached rows may pre-date the field and some providers
  /// don't always surface it.
  createdAt      DateTime?
  updatedAt      DateTime
  syncedAt       DateTime
  archived       Boolean   @default(false)

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@unique([projectId, providerItemId])
  @@index([projectId, kind, archived])
  @@index([projectId, updatedAt])
  @@index([projectId, parentId])
}

model Comment {
  id                String   @id @default(cuid())
  itemId            String
  /// Provider-native comment id, scoped under itemId.
  providerCommentId String
  author            String
  bodyMd            String
  createdAt         DateTime

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, providerCommentId])
  @@index([itemId, createdAt])
}

// ----------------------------------------------------------------------------
// Watchlist — per-user, per-project pinned items
// ----------------------------------------------------------------------------
//
// Pinning a providerItemId that is temporarily outside the active scope is
// valid; the render join just quietly excludes that row until the next sync
// re-adds it. So the FK target is the (projectId, providerItemId) tuple via
// a soft string match, not a hard FK to Item.id.

model WatchlistEntry {
  id             String   @id @default(cuid())
  userId         String
  projectId      String
  providerItemId String
  pinnedAt       DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, providerItemId])
  @@index([userId, pinnedAt(sort: Desc)])
}

// ----------------------------------------------------------------------------
// Saved views — per-user, per-project named visual filters
// ----------------------------------------------------------------------------
//
// Every narrowing dimension is a *visual* (post-cache) filter — sync pulls
// everything the credentials see, and `view-filter.ts`
// decides what renders. A SavedView captures the three filter axes the
// product surfaces:
//   - state bucket (open / closed / all) — over the canonical ItemState enum
//   - assignees (set of usernames; empty = no filter, "" entries match
//     unassigned)
//   - axes (per-provider-spec narrowing — area path / iteration / repo /
//     team / etc; declared by `ProviderSpec.scopeAxes`)
//
// One row per (user, project, name). One row per (user, project) may have
// `isDefault = true`; the application enforces this — no DB partial unique
// because Postgres needs an awkward partial index that Prisma 7 can't
// declare cleanly yet.

model SavedView {
  id          String   @id @default(cuid())
  userId      String
  projectId   String
  /// Display name shown in the picker. Unique per (user, project).
  name        String
  /// 'open' | 'closed' | 'all' — over the canonical ItemState enum.
  stateBucket String   @default("open")
  /// Usernames to include. Empty list = no assignee filter. An empty string
  /// in the list means "unassigned" (so the user can pin "show me unassigned
  /// items only").
  assignees   String[] @default([])
  /// Per-provider axis selections — `{ axisKey: expectedValue }`. The
  /// `ProviderSpec.axisMatcher` interprets each axis. Empty object means no
  /// axis filter.
  axes        Json     @default("{}")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, name])
  @@index([userId, projectId, isDefault])
}

// ----------------------------------------------------------------------------
// Per-project memory + sources
// ----------------------------------------------------------------------------

model MemoryEntry {
  id        String   @id @default(cuid())
  projectId String
  title     String
  bodyMd    String   @default("")
  tags      String[] @default([])
  /// 'user' | 'agent' — informational; both are equally durable.
  source    String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, updatedAt(sort: Desc)])
}

model SourceDoc {
  id        String   @id @default(cuid())
  projectId String
  title     String
  /// Free-text category ("requirements", "runbook", "design"). Empty allowed.
  kind      String   @default("")
  uri       String   @default("")
  bodyMd    String   @default("")
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, updatedAt(sort: Desc)])
  @@index([projectId, kind])
}

// ----------------------------------------------------------------------------
// Conversations + messages
// ----------------------------------------------------------------------------

model Conversation {
  id                    String    @id @default(cuid())
  projectId             String
  userId                String
  /// Optional item this conversation hangs off (project-wide chat when null).
  itemId                String?
  /// Per-conversation LLM override; null falls back to project default,
  /// which falls back to the global default LlmProvider.
  llmProviderIdOverride String?
  startedAt             DateTime  @default(now())
  archivedAt            DateTime?
  tokensIn              Int       @default(0)
  tokensOut             Int       @default(0)
  costCents             Int       @default(0)

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  llmOverride LlmProvider? @relation("ConversationLlmOverride", fields: [llmProviderIdOverride], references: [id], onDelete: SetNull)
  messages    Message[]

  @@index([projectId, archivedAt])
  @@index([userId, archivedAt])
  @@index([itemId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  /// 'system' | 'user' | 'assistant' | 'tool'. Vendor-neutral.
  role           String
  content        String
  /// Vendor-neutral discriminated tool-call payload. Null for non-tool turns.
  toolCallsJson  Json?
  toolCallId     String?
  toolName       String?
  /// True after the compaction service has folded this message into a
  /// synthetic system summary. Live transcript filters compacted == false.
  compacted      Boolean  @default(false)
  pending        Boolean  @default(false)
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, compacted, createdAt])
}

// ----------------------------------------------------------------------------
// Proposals — staged provider/memory writes awaiting confirmation
// ----------------------------------------------------------------------------

model Proposal {
  id             String    @id @default(cuid())
  projectId      String
  userId         String
  /// One of: state_change, description_patch, attachment_upload,
  /// item_create, comment_add, memory_write, memory_delete. Source of truth
  /// at the type layer is src/core/proposal-types.ts.
  kind           String
  /// Provider-native item id this proposal targets, when relevant. Null for
  /// item_create (the item doesn't exist yet) and memory_* (no item).
  providerItemId String?
  /// Full proposal payload (Item snapshot + the change). Type narrowing
  /// happens in `src/server/proposals/`.
  payload        Json
  /// 'pending' | 'confirmed' | 'rejected' | 'expired'.
  status         String    @default("pending")
  /// Populated when status flips to confirmed; the executor stamps it.
  confirmedAt    DateTime?
  /// Populated after the provider write succeeds; null while pending or
  /// while the executor is in flight.
  executedAt     DateTime?
  /// Populated when execution failed; the proposal stays in 'confirmed'
  /// state with this message attached so the user can retry.
  errorMessage   String?
  /// Optional non-blocking warning the builders attach when the staged write
  /// looks suspicious — e.g. a comment whose body closely echoes the item
  /// description. Surfaced in the confirm dialog so the human can verify
  /// before approving. Null when nothing to flag.
  advisory       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, status, createdAt(sort: Desc)])
  @@index([userId, status])
}

// ----------------------------------------------------------------------------
// MCP server config — per-project HTTP-only servers
// ----------------------------------------------------------------------------

model McpServerConfig {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  /// 'http' only — stdio transport is intentionally not supported because
  /// running operator-supplied subprocesses server-side is a security
  /// problem. Column shape accepts other transports without a migration if
  /// that decision ever gets revisited.
  transport   String   @default("http")
  url         String
  /// Optional headers (auth tokens, etc). Plaintext at rest today; the
  /// SECRETS_KEY encryption helper from `src/server/secrets/encryption.ts`
  /// can be wired here when these start carrying real bearer tokens.
  headersJson Json     @default("{}")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId, enabled])
}

// ----------------------------------------------------------------------------
// Generic key-value settings (per-user, per-project, or global)
// ----------------------------------------------------------------------------

model Setting {
  id        String   @id @default(cuid())
  /// Kebab-cased key (e.g. "ui.theme", "agent.compaction-threshold").
  key       String
  /// Stringified value. JSON encoding decided per-key by the consumer.
  value     String
  /// 'global' | 'user' | 'project'. The unique index uses the relevant
  /// FK column for user/project scope; global is enforced application-side
  /// (only one row with userId == null && projectId == null per key).
  scope     String
  userId    String?
  projectId String?
  /// True when `value` is AES-256-GCM ciphertext (`enc:v1:<iv>:<ct+tag>`)
  /// keyed by SECRETS_KEY. Set per-key by the consumer.
  encrypted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([key, userId, projectId])
  @@index([scope, key])
}

// ----------------------------------------------------------------------------
// Suggestions + command-usage counters
// ----------------------------------------------------------------------------

model Suggestion {
  id          String    @id @default(cuid())
  projectId   String
  /// Free-text category — the suggestion service decides what these mean.
  /// 'duplicate' | 'related' | 'transition' at minimum.
  kind        String
  payload     Json
  createdAt   DateTime  @default(now())
  /// When the user clicks "ignore" — kept for analytics rather than deleted.
  dismissedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, kind, dismissedAt])
}

/// Command palette usage counter — floats recently-used commands to the
/// top of the picker.
model CommandUsage {
  id         String   @id @default(cuid())
  userId     String
  projectId  String?
  /// Stable command id (e.g. "items.new", "memory.write"). Display labels
  /// can change without invalidating the counter.
  commandId  String
  lastUsedAt DateTime @default(now())
  usageCount Int      @default(1)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, commandId])
  @@index([userId, lastUsedAt(sort: Desc)])
}

// ----------------------------------------------------------------------------
// Sync cursor — per-project incremental sync watermark
// ----------------------------------------------------------------------------

model SyncCursor {
  projectId      String    @id
  watermark      DateTime?
  lastFullSyncAt DateTime?
  updatedAt      DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------------
// Audit log — append-only record of every confirmed/rejected proposal so the
// project owner can answer "who did what when" without reading server logs.
// ----------------------------------------------------------------------------

model Audit {
  id         String   @id @default(cuid())
  projectId  String
  /// Actor at the moment of the action — kept as a string id so user
  /// deletion doesn't cascade-erase the audit trail.
  userId     String?
  /// 'proposal.confirm' | 'proposal.confirm.failed' | 'proposal.reject'.
  /// Free-text so future actions can be added without a schema change.
  action     String
  /// Source proposal id when the action targets one. Nullable for non-
  /// proposal actions added later.
  proposalId String?
  /// Free-form payload (proposal kind, providerItemId, error message on
  /// failure, etc). Lives as JSON to keep the schema stable.
  payload    Json     @default("{}")
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, action])
}

// ----------------------------------------------------------------------------
// WebFetchEvent — append-only log of every URL the agent's web_fetch tool
// pulled on behalf of a user. Separate from Audit so the
// "audit writes only from the proposal executor" invariant (CLAUDE.md rule 9)
// stays intact: web_fetch writes to its own table.
// ----------------------------------------------------------------------------

model WebFetchEvent {
  id          String   @id @default(cuid())
  projectId   String
  /// Caller at the moment of the fetch. Kept as a string id (not a relation)
  /// so user deletion never cascade-erases this trail.
  userId      String?
  url         String
  /// 'ok' | 'error' | 'denied_disabled' | 'denied_url' |
  /// 'denied_host_allowlist' | 'denied_host_metadata' |
  /// 'denied_host_unresolved' | 'denied_redirect' | 'denied_type' |
  /// 'denied_size'. Free-text so the tool can grow new failure modes
  /// without a migration.
  status      String
  /// Response Content-Type header on success; null on denial / error.
  contentType String?
  /// Bytes returned (after truncation, before HTML stripping). 0 on denial.
  bytes       Int      @default(0)
  /// Error text when status != 'ok' — SSRF denial reason, host mismatch,
  /// fetch error, etc. Null on success.
  errorMessage String?
  /// HTML cleaning outcome. null = cleaning didn't apply (raw=true, non-HTML
  /// response, or denial before fetch). true = HTML was successfully converted
  /// to markdown. false = cleaning was attempted but failed/produced empty
  /// output and the tool fell back to the raw body.
  cleaned     Boolean?
  /// UTF-8 byte length of the cleaned markdown when `cleaned = true`.
  cleanedBytes Int?
  /// Reason cleaning failed when `cleaned = false` (parser error, empty
  /// output, etc.).
  cleanError  String?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, status])
}
